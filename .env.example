# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=ympv
POSTGRES_USER=ympv
POSTGRES_PASSWORD=changeme_strong_password_here

# ─── Backend ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=changeme_use_a_very_long_random_string_minimum_32_chars

# APP_ENV=dev
FRONTEND_URL=http://localhost
# ADMIN_EMAIL=
# MUSIC_DIR=/data

# ─── SMTP (signup email verification) ────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=changeme
# SMTP_PASS=changeme
# SMTP_FROM=YoutubeVault <no-reply@youtubevault.mylan>

# ─── Last.fm (Discover section + per-user scrobbling) ─────────────────────────
# LASTFM_API_KEY=
# LASTFM_API_SECRET=

# ─── slskd (Soulseek daemon — better-quality mp3 check during sync) ───────────
# Generate with: openssl rand -hex 32
SLSKD_API_KEY=changeme_generate_with_openssl_rand_hex_32
# Leave unset for vanilla slskd/slskd:latest (free search-only checks). Point
# at a modified slskd-API-compatible image to also enable the "auto-download
# HQ upgrades" toggle in Admin Settings — see services/hqReplace.ts.
# SLSKD_IMAGE=slskd/slskd:latest

# ─── Qobuz (fallback HQ source when slskd has no match) ───────────────────────
# No configuration needed — it's built into the backend service (see
# backend/src/services/qobuz/). Only relevant if the "auto-download HQ
# upgrades" toggle is on (see SLSKD_IMAGE above) AND a given user has opted
# into "Qobuz HQ music discovery" in their own profile settings (off by
# default). Its one-time community verification is a real Cloudflare
# Turnstile challenge, so it can only be completed by that opted-in user in
# their own browser — the app prompts them for it automatically (a small
# popup) whenever their HQ scan/sync needs it. No admin action required.

# ─── Optional ────────────────────────────────────────────────────────────────
# FRONTEND_PORT=80

# ─── docker-compose.prod.yml only (deploying published images, e.g. on OMV) ──
# GHCR_NAMESPACE=yourname/youtube-music-playlist-vault
# IMAGE_TAG=latest
