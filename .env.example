# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=ympv
POSTGRES_USER=ympv
POSTGRES_PASSWORD=changeme_strong_password_here

# ─── Backend ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=changeme_use_a_very_long_random_string_minimum_32_chars

# APP_ENV=dev
FRONTEND_URL=http://localhost
# ADMIN_EMAIL=
# MUSIC_DIR=/data

# ─── SMTP (signup email verification) ────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=changeme
# SMTP_PASS=changeme
# SMTP_FROM=YoutubeVault <no-reply@youtubevault.mylan>

# ─── Last.fm (Discover section + per-user scrobbling) ─────────────────────────
# LASTFM_API_KEY=
# LASTFM_API_SECRET=

# ─── slskd (Soulseek daemon — better-quality mp3 check during sync) ───────────
# Generate with: openssl rand -hex 32
SLSKD_API_KEY=changeme_generate_with_openssl_rand_hex_32
# Leave unset for vanilla slskd/slskd:latest (free search-only checks). Point
# at a modified slskd-API-compatible image to also enable the "auto-download
# HQ upgrades" toggle in Admin Settings — see services/hqReplace.ts.
# SLSKD_IMAGE=slskd/slskd:latest

# ─── Optional ────────────────────────────────────────────────────────────────
# FRONTEND_PORT=80

# ─── docker-compose.prod.yml only (deploying published images, e.g. on OMV) ──
# GHCR_NAMESPACE=yourname/youtube-music-playlist-vault
# IMAGE_TAG=latest
