generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String     @id @default(uuid())
  email                     String     @unique
  passwordHash              String
  displayName               String
  language                  String     @default("en")
  // 'light' | 'dark' — see frontend/src/theme.ts's getTheme(). Persisted
  // per-user (not localStorage) so it follows the account across devices,
  // same rationale as language above.
  themeMode                 String     @default("light")
  emailVerified             Boolean    @default(false)
  emailVerificationToken    String?    @unique
  emailVerificationExpires  DateTime?
  pendingEmail              String?
  isAdmin                   Boolean    @default(false)
  isBanned                  Boolean    @default(false)
  // Last.fm account link — see routes/auth.ts's /lastfm/connect+callback for
  // how this gets set (their "desktop auth" flow: a permanent session key,
  // not an expiring OAuth token) and services/lastfm.ts's scrobble() for how
  // it's used. scrobblingEnabled is a separate flag from "is connected" —
  // connecting doesn't turn it on by itself, see ProfilePage's toggle.
  lastfmSessionKey          String?
  lastfmUsername            String?
  scrobblingEnabled         Boolean    @default(false)
  // Default true: a track the local Essentia audio analysis classifies as
  // Non-Music, Audiobook, or Noise (see services/autoDeleteGenres.ts for the
  // exact genre set) is one nobody wants sitting in their music library, so
  // opt-out rather than opt-in. See audioAnalysisWorker.ts for where this is
  // checked per-track and syncService.ts's removeExistingNonMusicVideos for
  // the one-time sweep run when this flips from off to on (routes/auth.ts).
  autoDeleteNonMusicEnabled Boolean    @default(true)
  // "Now playing" broadcast — opt-in (default off), toggled from Profile ->
  // Settings. Lets GET /api/now-playing?email=... report what this user is
  // currently listening to, unauthenticated (see routes/nowPlaying.ts) — so
  // this is only ever populated/returned for a user who has explicitly
  // turned it on. Artist/title are a denormalized snapshot (same philosophy
  // as PlaylistVideo.originalTitle) rather than a foreign key to
  // PlaylistVideo, so they survive the track being deleted mid-playback.
  // nowPlayingHeartbeatAt is refreshed by the client every ~25s while a
  // track is actively playing (not paused) — routes/nowPlaying.ts treats a
  // heartbeat older than NOW_PLAYING_STALE_MS as "nothing playing" even
  // though these fields are technically still populated, which is what
  // clears a stale value once the app is closed/backgrounded without a
  // chance to call the clear endpoint, without needing a cron sweep.
  nowPlayingPublic          Boolean    @default(false)
  nowPlayingArtist          String?
  nowPlayingTitle           String?
  nowPlayingHeartbeatAt     DateTime?
  // Durable cross-device mini-player resume state — unlike nowPlaying*
  // above (a soft-expiring public broadcast with no track identifiers),
  // this is a private snapshot precise enough to actually reconstruct
  // playback: which track, where in it, and the full queue/shuffle-history
  // around it. Written by the web client (PlayerContext.tsx) on session
  // start, track advance, pause, and periodically while playing; read back
  // once on app mount to restore the mini player (paused, not autoplaying)
  // on a different device/session. Cleared (all fields null) only when the
  // user explicitly closes the mini player — see routes/playbackState.ts.
  playbackPlaylistId        String?
  playbackVideoId           String?
  playbackPositionSeconds   Float?
  playbackIsShuffle         Boolean    @default(false)
  playbackIsRepeat          Boolean    @default(false)
  playbackOriginPath        String?
  // Ordered array of { playlistId, videoId } pairs — the exact queue as of
  // session start, so "All Tracks"/shuffled sessions resume with next/prev
  // intact rather than being re-derived from a single playlist.
  playbackQueue             Json?
  // Same shape as playbackQueue — shuffle mode's "previous" stack, mirrors
  // PlayerContext.tsx's historyRef (capped at MAX_HISTORY = 50).
  playbackHistory           Json       @default("[]")
  playbackUpdatedAt         DateTime?
  // A user's own Deezer account "arl" cookie — opt-in, per-user (unlike
  // slskd/JioSaavn, which are app-wide fallbacks), since it authorizes
  // downloading tracks that specific Deezer account is entitled to, not a
  // shared/free catalog. See services/deezer.ts/deezerReplace.ts and
  // routes/auth.ts's /deezer endpoints. deezerCookieValid is null until the
  // first check ever runs, then reflects the outcome of the most recent
  // one — resolvePlaylistQuality (see slskdQualityWorker.ts) re-verifies it
  // once per sync pass, before touching any track, rather than discovering
  // "this cookie is dead" from a failure on every single video.
  deezerArlCookie           String?
  deezerCookieValid         Boolean?
  deezerCookieCheckedAt     DateTime?
  // A user's own Qobuz account email/password — opt-in, per-user, same
  // rationale as deezerArlCookie above. Unlike Deezer, Qobuz has no
  // long-lived cookie an end user can copy out of their browser, so the
  // credential here is the account's real login instead of a session
  // token; see services/qobuz.ts for how it's used (a fresh user/login call
  // establishes a session, never persisted beyond one sync pass) and
  // routes/auth.ts's /qobuz endpoints for how it's saved. qobuzCredentialsValid
  // follows the same null-until-first-check/most-recent-outcome contract as
  // deezerCookieValid.
  qobuzEmail                String?
  qobuzPassword             String?
  qobuzCredentialsValid     Boolean?
  qobuzCredentialsCheckedAt DateTime?
  // A user's own Tidal account tokens — opt-in, per-user, same rationale as
  // deezerArlCookie/qobuzEmail above. Tidal has neither a copyable session
  // cookie (Deezer) nor a real username/password login (Qobuz) usable here —
  // it's a device-code OAuth2 flow, the same one Tidal's own TV/games-console
  // apps use: the user opens a short link and enters a code this app shows
  // them, see routes/auth.ts's /tidal/start+poll endpoints and
  // services/tidal.ts. What's stored is the resulting access/refresh token
  // pair (never a password) plus the userId/countryCode Tidal's API calls
  // need alongside it; establishTidalSession refreshes the access token in
  // place as needed rather than a fresh login every sync pass, since there's
  // nothing to "log in" with here beyond the refresh token itself.
  // tidalCredentialsValid follows the same null-until-first-check/
  // most-recent-outcome contract as deezerCookieValid/qobuzCredentialsValid.
  tidalAccessToken          String?
  tidalRefreshToken         String?
  tidalUserId               String?
  tidalCountryCode          String?
  tidalCredentialsValid     Boolean?
  tidalCredentialsCheckedAt DateTime?
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
  playlists                 Playlist[]
  logs                      Log[]
  syncReports               SyncReport[]

  @@map("users")
}

model Playlist {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null only for a "generated" playlist (see sourcePlaylistId below) — it has
  // no real YouTube playlist behind it, so nothing to sync against. Every
  // normal, user-added playlist still always has one.
  youtubeId    String?
  title        String
  customName   String?
  thumbnailUrl String?
  videoCount   Int             @default(0)
  syncStatus   String          @default("idle")
  syncPaused   Boolean         @default(false)
  // Set by the mobile app's offline-download feature (see mobile/src/offline/)
  // — the actual downloaded files only ever live on-device, this is purely
  // "the user turned this on," so a fresh install / lost-and-replaced phone
  // can tell which playlists to re-download rather than starting from
  // nothing. Not consulted by anything server-side.
  offlineEnabled Boolean       @default(false)
  lastSyncedAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  videos       PlaylistVideo[]
  syncReports  SyncReport[]

  // Marks this playlist as generated ("similar/alternative playlist") from
  // another one, rather than imported from a real YouTube playlist. @unique
  // enforces "at most one generated playlist per source" at the DB level —
  // multiple NULLs (the common case, a normal playlist) don't collide.
  // onDelete: SetNull means deleting the source doesn't delete its
  // derivative — sourcePlaylistName (snapshotted at generation time, same
  // philosophy as PlaylistVideo.originalTitle) keeps the "Based on X" label
  // intact even if the source is later renamed or deleted.
  sourcePlaylistId   String?   @unique
  sourcePlaylist     Playlist? @relation("PlaylistSource", fields: [sourcePlaylistId], references: [id], onDelete: SetNull)
  generatedPlaylist  Playlist? @relation("PlaylistSource")
  sourcePlaylistName String?

  @@unique([userId, youtubeId])
  @@map("playlists")
}

model PlaylistVideo {
  id                     String     @id @default(uuid())
  playlistId             String
  playlist               Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  youtubeId              String
  title                  String
  // The raw YouTube title exactly as it was when this row was first created —
  // set once and never touched again, unlike `title` which gets cleaned up
  // (artist/junk-suffix stripped) by the metadata pipeline over time. Kept
  // around as a source of truth for re-matching later, since `title` alone
  // can lose information (e.g. the artist) once it's been cleaned.
  originalTitle          String?
  duration               Int?
  thumbnailUrl           String?
  position               Int
  isAvailable            Boolean    @default(true)
  // The uploading channel, captured at sync time — used as an artist fallback
  // when the title itself doesn't look like "Artist - Title" (see musicbrainz.ts).
  channelName            String?
  downloadStatus         String     @default("pending")
  downloadError          String?
  // Set the first time a regular sync's YouTube fetch doesn't include this
  // video, cleared the moment a later sync sees it again — a one-fetch
  // grace period before refreshPlaylistFromYoutube actually treats it as
  // removed (GC's the shared file, forces every offline-synced phone to
  // redownload it). A single video dropping out of one yt-dlp scrape
  // happens on its own, well under the mass-truncation safety threshold
  // below, and used to be enough to trigger a full spurious redownload for
  // a video that never actually changed. Never touched by soft reimport
  // (skipRemoval) — see reimport.ts.
  missingSince           DateTime?
  // Counts every download attempt (initial sync and each explicit retry
  // alike) that ended in a non-permanent failure — see downloadPendingVideos
  // in syncService.ts. Once this reaches MAX_DOWNLOAD_ATTEMPTS, the video is
  // removed from the playlist outright instead of being marked failed again,
  // so a persistently-broken video can't be retried forever.
  downloadAttempts       Int        @default(0)
  mediaFileId            String?
  mediaFile              MediaFile? @relation(fields: [mediaFileId], references: [id], onDelete: Restrict)
  fileSize               Int?
  bitrate                Int?
  // Set once at row creation and never touched again — unlike createdAt (a general
  // audit column elsewhere in the app), this is specifically the "date added to
  // this library" used to order/filter entries independently of YouTube's mutable
  // playlist `position`.
  addedAt                DateTime   @default(now())
  // Best-effort MusicBrainz enrichment — looked up once (per video) in the
  // background during sync, gated on connectivity and never blocking downloads.
  artist                 String?
  album                  String?
  trackNumber            Int?
  // Sourced from local Essentia audio-content analysis (see audio-analysis/
  // and audioAnalysisWorker.ts), not MusicBrainz — MB's crowd-sourced genre
  // tags are missing for most non-mainstream recordings, audio analysis
  // works on every downloaded track regardless. An array, not a single
  // value: a broad genre like "Electronic" covers wildly different-sounding
  // music, so a track can carry more than one parent genre (a genuine
  // Electronic/Hip Hop hybrid, say) plus one specific style tag — see
  // audio-analysis/app.py for how the list is built. Empty, not null, when
  // nothing's been determined yet.
  genres                 String[]   @default([])
  releaseYear            Int?
  mbRecordingId          String?
  metadataStatus         String     @default("pending") // pending | found | not_found | error
  metadataFetchedAt      DateTime?
  // Needs the actual downloaded audio (unlike metadataStatus above, which only
  // needs the title), so this only ever progresses once downloadStatus is
  // 'done' — see audioAnalysisWorker.ts.
  audioAnalysisStatus    String     @default("pending") // pending | done | error
  audioAnalysisFetchedAt DateTime?
  // Track-level mean-pooled embedding from the Discogs-EffNet audio model —
  // captured now, as a free byproduct of genre classification, so a future
  // similarity/recommendation feature doesn't need to re-analyze the whole
  // library from scratch. Raw float32 bytes (not JSON — a few KB instead of
  // ~20KB of text per track); no consumer yet.
  audioEmbedding         Bytes?
  // Internal listening stats — incremented from POST .../played whenever
  // playback reaches the end naturally (see PlayerContext's handleTrackEnded
  // on the frontend), independent of whether Last.fm scrobbling is on. Not
  // gated on any minimum-listened threshold: "finished" already implies that.
  playCount              Int        @default(0)
  lastPlayedAt           DateTime?
  // Set the instant playback of this track starts (POST .../play-started) —
  // deliberately separate from lastPlayedAt above, which only ever advances
  // on natural completion. Backs the Listening History list/summary
  // (GET /history, GET /history/summary), which wants "you hit play on
  // this" ordering rather than "you finished it".
  lastPlayStartedAt      DateTime?
  // Set once a slskd (Soulseek daemon) search turns up an mp3 result with a
  // higher bitrate than what we actually downloaded — see
  // services/slskd.ts/slskdQualityWorker.ts. Checked once per video, like
  // metadataStatus below, not re-checked on every subsequent sync.
  betterQualityExists    Boolean    @default(false)
  qualityCheckStatus     String     @default("pending") // pending | checked | error
  qualityCheckedAt       DateTime?
  // True only once the commercial HQ service's file was actually downloaded
  // and used to replace the shared mp3 in place (see services/hqReplace.ts)
  // — never set by the free self-hosted slskd path, which only ever flags
  // betterQualityExists above without touching the file.
  hqFileDownloaded       Boolean    @default(false)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@unique([playlistId, youtubeId])
  @@index([playlistId, position])
  @@index([playlistId, downloadStatus])
  @@index([playlistId, artist])
  // No index on genres: it's an array now (no plain btree equivalent to the
  // old single-value one), and genre filtering has only ever happened
  // client-side against an already-fetched video list — no backend query
  // filters or sorts by it, so there's nothing to speed up here.
  // Used by the standalone metadata worker's global (cross-playlist) queue query —
  // without this, "find the next pending video across every playlist" degrades to a
  // full table scan once a library gets into the tens of thousands of rows.
  @@index([metadataStatus, addedAt])
  // Same rationale, for the audio-analysis worker's equivalent global queue query.
  @@index([audioAnalysisStatus, addedAt])
  @@map("playlist_videos")
}

/// Singleton settings row (always id=1) — SMTP and Postgres connection values
/// that started life as env vars (see config.ts) but are now admin-editable
/// at runtime via /api/admin/settings, taking precedence over env from then
/// on. See services/settings.ts for the env-seeding-on-first-read and
/// services/prisma.ts for how a Postgres change is tested before it's ever
/// applied to the live connection.
model AppSettings {
  id Int @id @default(1)

  // Optional — a null host means "email verification is off"; see
  // services/mailer.ts and the register/resend/profile-update routes.
  smtpHost   String?
  smtpPort   Int     @default(587)
  smtpSecure Boolean @default(false)
  smtpUser   String?
  smtpPass   String?
  smtpFrom   String  @default("YoutubeVault <no-reply@localhost>")

  // Required — this app always needs *a* database; the admin UI only lets
  // you point at a different already-migrated one, never an empty value.
  postgresDb       String
  postgresUser     String
  postgresPassword String

  // Both optional. apiKey alone is enough for the read-only "Discover"
  // section (see routes/youtube.ts's /discover); apiSecret is only needed
  // once a user tries to actually connect+scrobble, since signing
  // auth.getSession/track.scrobble requires it — see services/lastfm.ts.
  lastfmApiKey    String?
  lastfmApiSecret String?

  hqAutoDownloadEnabled Boolean @default(false)

  // Which per-user, opt-in-with-own-credentials HQ providers (Deezer, Qobuz,
  // and Tidal — see services/deezer.ts/services/qobuz.ts/services/tidal.ts)
  // users are allowed to connect at all. Unlike hqAutoDownloadEnabled above
  // (a single app-wide on/off switch for the whole HQ-replace pipeline), this
  // is a per-provider allow-list: disabling an entry here hides that
  // provider's section from every user's own profile (see routes/auth.ts's
  // /me) and makes resolvePlaylistQuality skip it outright during a sync,
  // even for a user who already has credentials saved for it (see
  // slskdQualityWorker.ts) — existing saved credentials are left alone, just
  // unused while disabled. Only Deezer is in the default array — admins opt
  // into Qobuz/Tidal explicitly.
  hqAllowedUserProviders String[] @default(["deezer"])

  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// Audit trail of user-initiated playlist actions, surfaced on the admin
/// Logs page. Not pruned yet — see backend/src/services/auditLog.ts.
/// playlistId is a plain (non-FK) reference — deliberately, so a log entry
/// survives the playlist it refers to being deleted; `details` always
/// snapshots the playlist's name at action time so the log stays readable
/// even after that.
model Log {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  playlistId String?
  details    Json
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("logs")
}

/// One row per completed sync / retry-failed / scan-hq / import run — the
/// source for both the notification bell (see NotificationsContext in the
/// frontend) and the stats modal shown live on the Playlists page (see the
/// /sync-reports endpoints in routes/youtube.ts and the writer in
/// syncService.ts, which creates one of these when
/// syncPlaylist/retryFailedVideos/scanForHqUpgrades/startBackgroundDownload's
/// initial-import call finishes). Distinct from Log above: Log is an
/// admin-only audit trail with a handful of summary fields; this is the
/// user-facing, per-run detail report, keyed to a specific playlist rather
/// than a generic action feed. seenAt stays null until the user actually
/// views it (opens the notification bell, or dismisses the live modal), so a
/// run that finished while they weren't looking is still waiting whenever
/// they next check — even weeks later.
model SyncReport {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  actionType String   // sync | retry_failed | scan_hq | import — see SyncActionType in syncService.ts
  startedAt  DateTime
  durationMs Int

  // Only ever non-zero for actionType 'sync' — the only pass that touches
  // YouTube's own playlist listing (see refreshPlaylistFromYoutube).
  addedCount   Int @default(0)
  removedCount Int @default(0)

  // downloadedCount is a video that was pending and succeeded; recoveredCount
  // is one that was specifically failed before this run and succeeded now
  // (only meaningfully distinct for actionType 'retry_failed' — see
  // priorFailedIds in downloadPendingVideos).
  downloadedCount Int @default(0)
  recoveredCount  Int @default(0)
  failedCount     Int @default(0)
  // Bucketed by categorizeFailure in syncService.ts, e.g.
  // {"rate_limited": 2, "unavailable": 1} — only buckets that actually
  // occurred this run are present.
  failureReasons  Json @default("{}")
  // Per-video detail behind those bucket counts — [{title, reason, message}],
  // capped at MAX_FAILURE_DETAILS in syncService.ts so one run's failures
  // can't turn into an unbounded JSON blob; failedCount above is the
  // uncapped total. Lets the stats modal show the actual yt-dlp error per
  // video instead of just a bucket count, since a video that ends up here
  // (isAvailable: false) is hidden everywhere else in the app with no other
  // way to see why.
  failureDetails Json @default("[]")

  // A slskd/JioSaavn upgrade newly found (or, with HQ auto-download on,
  // newly downloaded) this run — see onHqFound in slskdQualityWorker.ts.
  // Never counts a video whose upgrade was already known from a past run.
  newHqCount Int @default(0)

  seenAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, seenAt])
  @@map("sync_reports")
}

/// Single shared, content-addressed copy of a downloaded YouTube video's MP3,
/// keyed by youtubeId so the same video is stored once regardless of how many
/// playlists/users reference it. PlaylistVideo.mediaFileId's onDelete: Restrict
/// is what makes GC trivial — deleting a row here fails while any
/// PlaylistVideo still points to it, succeeds once nothing does.
model MediaFile {
  id        String          @id @default(uuid())
  youtubeId String          @unique
  filename  String          @unique
  fileSize  Int
  bitrate   Int?
  createdAt DateTime        @default(now())
  videos    PlaylistVideo[]

  @@map("media_files")
}

/// Cached third-party artist metadata (bio + photo), fetched lazily the first
/// time an Artist page is visited — see services/artistInfo.ts. Global, not
/// per-user, like MediaFile: an artist's bio isn't user-specific, so there's
/// no reason to fetch it again for a second user with the same artist in
/// their library. normalizedName is the lookup key (same trim+lowercase
/// convention as genre keys); fetchedAt stays null until the first fetch
/// attempt actually completes (success or a confirmed "nothing found") so a
/// later visit doesn't just keep retrying it — see getOrFetchArtistInfo.
model ArtistInfo {
  id             String    @id @default(uuid())
  normalizedName String    @unique
  name           String
  bio            String?
  thumbnailUrl   String?
  fetchedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("artist_info")
}
